# Environment template. Copy to `.env` and fill in real values:
#   cp .env.example .env
#
# .env is loaded at startup (flutter_dotenv) and bundled as an asset, so it is
# required for the app to run. Keep any genuinely secret value OUT of here and
# out of the client entirely — anything shipped in the APK can be extracted.
#
# API_URL must be your production HTTPS API base for a release build.
# WEB_URL must be the production website (NOT http://localhost:3000).

API_URL=https://your-production-api.example.com
WEB_URL=https://your-production-website.example.com
