<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) backup / device-transfer rules.
  Excludes the secure-storage and preference files that hold auth tokens and the
  theme flag so they are never copied to cloud backup or another device. (The
  secure-storage key lives in the Android Keystore and is not backed up anyway,
  so excluding the encrypted blob just avoids leaving stale, undecryptable data.)
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml" />
    </device-transfer>
</data-extraction-rules>
