<?xml version="1.0" encoding="utf-8"?>
<!--
  Legacy (API 30 and below) full-backup rules. Mirrors data_extraction_rules.xml:
  keep the secure-storage / preference files out of auto-backup so auth tokens
  are not written to cloud backups.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    <exclude domain="sharedpref" path="FlutterSharedPreferences.xml" />
</full-backup-content>
