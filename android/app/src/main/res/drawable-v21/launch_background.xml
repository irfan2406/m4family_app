<?xml version="1.0" encoding="utf-8"?>
<!-- Native launch screen: deep-green M4 ground so the native -> Flutter handoff
     is seamless (no white/black flash before the green app UI). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_bg"/>
    <item>
        <bitmap android:gravity="center" android:src="@drawable/android12splash"/>
    </item>
</layer-list>
